# Reserved for future local development. Never put real secrets in this file.
APP_ENV=local
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./ai_sdlc_local.db
LLM_PROVIDER=none

# Agent identity tokens are injected by environment / secret manager at runtime only.
# Do not paste actual values into this file or commit them.
AI_SDLC_DB_PATH=data/ai_sdlc.db
AI_SDLC_ADMIN_TOKEN=<set-in-secret-manager>
AI_SDLC_AGENT_TOKEN=<set-per-agent-at-runtime>
